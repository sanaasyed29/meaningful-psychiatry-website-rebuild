<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = seoTitle or (title + " - " + site.name if title else site.name) %}
  {#- Pages without a description fall back to the start of their own text #}
  {%- set description = description or (content | autoDescription) %}
  <title>{{ pageTitle }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  {%- endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Blog" href="/feed/">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  {%- if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:image" content="{{ (image or '/images/2025/12/DR_Badeea_Qureshi.webp') | absoluteUrl(site.url) }}">
  <link rel="icon" href="/favicon.webp" type="image/webp">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700;800&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400;1,500;1,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- if page.url == "/" %}
  <script type="application/ld+json">{{ schema | dump | safe }}</script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
