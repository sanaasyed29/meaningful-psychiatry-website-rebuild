<article class="post-card">
  <a href="{{ post.url }}" class="post-card__img"><img src="{{ post.data.image }}" alt="" loading="lazy"></a>
  <div class="post-card__body">
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p>{{ post.data.excerpt | truncateWords(70) }}</p>
    <a href="{{ post.url }}" class="read-more">Read More »</a>
  </div>
  <div class="post-card__meta">{{ post.date | readableDate }}</div>
</article>
