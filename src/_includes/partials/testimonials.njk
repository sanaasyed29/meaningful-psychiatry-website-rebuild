<section class="section testimonials">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Testimonials</p>
      <h2>What people say</h2>
    </div>
    <div class="carousel" data-carousel>
      <div class="carousel__track">
        {%- for t in testimonials %}
        <blockquote class="carousel__slide{% if loop.first %} is-active{% endif %}">
          <i class="fa-solid fa-quote-left carousel__mark" aria-hidden="true"></i>
          <p>{{ t }}</p>
        </blockquote>
        {%- endfor %}
      </div>
      <div class="carousel__controls">
        <button class="carousel__btn carousel__btn--prev" aria-label="Previous testimonial"><i class="fa-solid fa-arrow-left"></i></button>
        <span class="carousel__count" aria-live="polite">1 / {{ testimonials.length }}</span>
        <button class="carousel__btn carousel__btn--next" aria-label="Next testimonial"><i class="fa-solid fa-arrow-right"></i></button>
      </div>
    </div>
  </div>
</section>
