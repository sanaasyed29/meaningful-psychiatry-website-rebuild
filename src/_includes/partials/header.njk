<div class="topbar">
  <div class="container topbar__inner">
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    <a href="{{ site.phoneLink }}"><strong>Call or Text Us:</strong> {{ site.phone }}</a>
    <a href="/contact-us/" class="topbar__cta">Contact Us</a>
  </div>
</div>
<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="logo"><img src="/images/2024/08/meaningful_psychiatry_logo_200-e1725654247478.webp" alt="{{ site.name }}" width="100" height="50"></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- if item.children %}
        <li class="has-sub">
          <button class="sub-toggle" aria-expanded="false">{{ item.label }} <i class="fa-solid fa-angle-down" aria-hidden="true"></i></button>
          <ul class="sub-menu">
            {%- for child in item.children %}
            <li><a href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- else %}
        <li><a href="{{ item.url }}"{% if item.url | isActive(page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
