<div class="topbar" role="region" aria-label="Crisis line and contact information">
  <div class="container topbar__inner">
    <p class="topbar__crisis"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> In crisis? Call or text <a href="tel:988">988</a>. For emergencies, call <a href="tel:911">911</a>.</p>
    <div class="topbar__contact">
      <a href="{{ site.phoneLink }}"><i class="fa-solid fa-phone" aria-hidden="true"></i> {{ site.phone }}</a>
      <a href="mailto:{{ site.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i> {{ site.email }}</a>
      <a href="{{ site.portalUrl }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Patient Portal</a>
    </div>
  </div>
</div>
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo"><img src="/images/2024/08/meaningful_psychiatry_logo_200-e1725654247478.webp" alt="{{ site.name }}" width="100" height="50"></a>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- if item.children %}
        <li class="has-sub">
          <button class="sub-toggle" aria-expanded="false">{{ item.shortLabel or item.label }} <i class="fa-solid fa-angle-down" aria-hidden="true"></i></button>
          <ul class="sub-menu">
            {%- for child in item.children %}
            <li><a href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
            {%- endfor %}
          </ul>
        </li>
        {%- else %}
        <li><a href="{{ item.url }}"{% if item.url | isActive(page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
    <a href="{{ site.bookingUrl }}" class="btn btn--sm header-book" target="_blank" rel="noopener noreferrer">Book Now</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
