<form class="contact-form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-ajax-form>
  <input type="hidden" name="form-name" value="contact">
  <input type="hidden" name="subject" value="New website message - Meaningful Psychiatry">
  <p class="sr-only"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
  {%- set fid = (page.url | slugify) or "home" %}
  <div class="contact-form__grid">
    <div class="field"><label for="cf-first-{{ fid }}">First name <span aria-hidden="true">*</span></label><input id="cf-first-{{ fid }}" type="text" name="First Name" autocomplete="given-name" required></div>
    <div class="field"><label for="cf-last-{{ fid }}">Last name <span aria-hidden="true">*</span></label><input id="cf-last-{{ fid }}" type="text" name="Last Name" autocomplete="family-name" required></div>
    <div class="field"><label for="cf-email-{{ fid }}">Email <span aria-hidden="true">*</span></label><input id="cf-email-{{ fid }}" type="email" name="Email" autocomplete="email" required></div>
    <div class="field"><label for="cf-phone-{{ fid }}">Phone <span aria-hidden="true">*</span></label><input id="cf-phone-{{ fid }}" type="tel" name="Phone Number" autocomplete="tel" required></div>
    <div class="field"><label for="cf-ins-{{ fid }}">Insurance</label>
      <select id="cf-ins-{{ fid }}" name="Insurance">
        <option value="">Select…</option>
        {%- for opt in site.insuranceOptions %}
        <option value="{{ opt }}">{{ opt }}</option>
        {%- endfor %}
      </select>
    </div>
    <div class="field"><label for="cf-time-{{ fid }}">Preferred day/time</label><input id="cf-time-{{ fid }}" type="text" name="Preferred Day/Time"></div>
    <div class="field field--full"><label for="cf-ref-{{ fid }}">How did you hear about us?</label><input id="cf-ref-{{ fid }}" type="text" name="Referral Source"></div>
    <div class="field field--full"><label for="cf-msg-{{ fid }}">How can we help? <span aria-hidden="true">*</span></label><textarea id="cf-msg-{{ fid }}" name="Message" rows="4" required></textarea></div>
  </div>
  <label class="check"><input type="checkbox" name="Newsletter" value="Yes"> I'd like to subscribe to the Meaningful Psychiatry newsletter (optional)</label>
  <button type="submit" class="btn btn--block btn--lg">Send Message <i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
  <p class="privacy-note"><i class="fa-solid fa-lock" aria-hidden="true"></i> <span><strong>Your privacy matters.</strong> Please don't include detailed medical information in this message. Your health history is collected during intake through Osmind, our secure, HIPAA-compliant patient platform. Submitting this form does not establish a doctor-patient relationship.</span></p>
</form>
