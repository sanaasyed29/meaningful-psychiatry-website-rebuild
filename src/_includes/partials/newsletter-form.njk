<form class="newsletter-form" name="newsletter" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" data-ajax-form>
  <input type="hidden" name="form-name" value="newsletter">
  <input type="hidden" name="subject" value="New newsletter sign-up - Meaningful Psychiatry">
  <p class="sr-only"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
  <p>Mental health insights and practice news from Dr. Qureshi.</p>
  <label class="sr-only" for="nl-email-{{ page.url | slugify }}">Email address</label>
  <div class="newsletter-form__row">
    <input id="nl-email-{{ page.url | slugify }}" type="email" name="email" placeholder="Email address" autocomplete="email" required>
    <button type="submit" class="btn">Subscribe</button>
  </div>
</form>
