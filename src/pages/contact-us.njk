    {%- if site.inquiryFormUrl %}<p class="center booking-card__help">Form not loading? <a href="{{ site.inquiryFormUrl }}" target="_blank" rel="noopener noreferrer">Open it in a new tab</a>.</p>{% endif %}
  </div>
