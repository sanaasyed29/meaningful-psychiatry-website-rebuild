---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: group
permalink: "/tag/{{ group.name | slugify }}/"
eleventyComputed:
  title: "{{ group.name }}"
---
<section class="page-hero">
  <p class="eyebrow">Tag</p>
  <h1 class="page-title page-title--white">{{ group.name }}</h1>
</section>
<section class="section section--tight">
  <div class="container container--mid">
    <div class="post-grid">
      {%- for post in group.posts %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
