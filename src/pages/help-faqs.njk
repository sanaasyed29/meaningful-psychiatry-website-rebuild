---
layout: layouts/base.njk
title: Help and FAQs
permalink: /help-faqs/
description: "Get answers to our most frequently asked questions about virtual psychiatric care, insurance, scheduling and more at Meaningful Psychiatry."
---
<section class="page-hero">
  <div class="container">
    <h1 class="page-title">Frequently Asked Questions</h1>
  </div>
</section>

<section class="section section--tight">
  <div class="container container--mid">
    <div class="faq">
      {%- for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.question }}</summary>
        <div class="faq__answer">{{ f.answer | safe }}</div>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>

