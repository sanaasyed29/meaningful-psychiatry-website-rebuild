---
layout: layouts/base.njk
pagination:
  data: collections.archiveList
  size: 1
  alias: group
permalink: "/{{ group.key }}/"
eleventyComputed:
  title: "{{ group.date | monthYear }}"
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow eyebrow--light">Archives</p>
    <h1 class="page-title">{{ group.date | monthYear }}</h1>
  </div>
</section>
<section class="section section--tight">
  <div class="container container--mid">
    <h2 class="sr-only">Articles</h2>
    <div class="post-grid">
      {%- for post in group.posts %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
