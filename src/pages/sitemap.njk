---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if p.url and not p.data.eleventyExcludeFromCollections and not ("/tag/" in p.url) and not ("/page/" in p.url) and not ("/service/" in p.url and p.url != "/service/") and not (p.url | isDateArchive) %}
  <url><loc>{{ p.url | absoluteUrl(site.url) }}</loc><lastmod>{{ p.date | isoDate }}</lastmod></url>
{%- endif %}
{%- endfor %}
{%- for s in interests %}
  <url><loc>{{ ("/service/" + s.slug + "/") | absoluteUrl(site.url) }}</loc></url>
{%- endfor %}
</urlset>
