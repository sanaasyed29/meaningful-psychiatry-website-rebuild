<section class="page-hero">
  <div class="container">
    <p class="eyebrow eyebrow--light">Integrative Approach</p>
    <h1 class="page-title">Special Interests in Psychotherapy</h1>
  </div>
</section>
<section class="section section--tight">
  <div class="container">
    <div class="interest-grid">
      {%- for s in interests %}
      <a class="interest-card" href="/service/{{ s.slug }}/">
        <span class="interest-card__icon"><img src="{{ s.icon }}" alt="" loading="lazy"></span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
        <span class="interest-card__foot"></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
