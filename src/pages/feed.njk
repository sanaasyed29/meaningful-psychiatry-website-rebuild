---
permalink: /feed/index.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name }} Blog</title>
    <link>{{ site.url }}/blog/</link>
    <atom:link href="{{ "/feed/" | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml"/>
    <description>Articles and podcast episodes from Dr. Badeea Qureshi and Meaningful Psychiatry.</description>
    <language>en-us</language>
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      <guid>{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.date | rfcDate }}</pubDate>
      <description>{{ post.data.excerpt }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
